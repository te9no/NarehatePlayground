---
import { assemblies, modules, catalog, yen } from '../lib/price-simulator.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const extras = [
  { id: 'case', title: 'ケース・印刷部品', quantity: '一式', hint: 'ケースなし構成のみ。印刷材料・外注費などを入力。', link: catalog.caseUrl, linkText: 'ケースデータ' },
  { id: 'left', title: '左モジュール', quantity: '1個', hint: '選んだモジュールの価格。組立状態と同梱品を確認。', link: catalog.moduleUrl, linkText: 'MeKaBu Project' },
  { id: 'right', title: '右トラックボールモジュール', quantity: '1個', hint: 'ボールが別売の場合は、下のボール費用にも入力。', link: catalog.moduleUrl, linkText: 'MeKaBu Project' },
  { id: 'switches', title: 'キースイッチ', quantity: '46個分', hint: 'Kailh Choc V2互換。ソケット46個は本体に付属。' },
  { id: 'keycaps', title: 'キーキャップ', quantity: '46個分', hint: 'MX型十字ステム対応・17mmピッチ用。' },
  { id: 'batteries', title: '電池', quantity: '2個分', hint: '単4形Ni-MH充電池、左右各1個。一次電池は不可。' },
  { id: 'balls', title: 'ボール・サイズ別部品', quantity: '1セット分', hint: '選んだケースに合う径・部品を確認。モジュール代に含む場合は0円。' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="GeaconPolarisの構成・追加費用・購入リストを確認する価格シミュレータの試作ページ。" />
    <title>価格シミュレータ / TEST — なれはてぷれいぐらうんど</title>
    <link rel="icon" href={`${base}favicon.png`} />
  </head>
  <body>
    <a class="skip" href="#configurator">構成の選択へ</a>
    <header class="topbar">
      <a class="brand" href={base}><span aria-hidden="true">✳</span> なれはてぷれいぐらうんど</a>
      <span class="test-badge">TEST / 試作公開</span>
    </header>
    <main>
      <section class="hero" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">BUILD YOUR POLARIS</p>
          <h1 id="page-title">好きな構成を。<br />費用は、見える形に。</h1>
          <p class="hero-copy">組み方とモジュールを選ぶと、必要な部品・費用・残る作業が<br class="desktop-break" />ひとつに。あなたのGeaconPolarisを組み立ててみましょう。</p>
          <a class="text-link" href={`${base}guides/20geaconpolaris/`}>製品の購入・ビルドガイド <span aria-hidden="true">↗</span></a>
        </div>
        <div class="product-visual" aria-hidden="true">
          <div class="orbit"></div>
          <div class="keyboard"><div class="half left-half"><div class="keys">{Array.from({ length: 18 }).map(() => <i></i>)}</div><div class="knob" id="module-visual"></div><div class="thumbs"><i></i><i></i><i></i></div></div><div class="half right-half"><div class="keys">{Array.from({ length: 18 }).map(() => <i></i>)}</div><div class="ball"></div><div class="thumbs"><i></i><i></i><i></i></div></div></div>
          <p>GEACON POLARIS <span>構成イメージ / 実際の形状とは異なります</span></p>
        </div>
      </section>
      <p class="trial-note"><span>試作版</span> 現在はGeaconPolarisのみ対応。注文・決済は行いません。価格・在庫は自動更新されません。</p>
      <noscript><p class="error">このシミュレータの計算にはJavaScriptが必要です。購入条件はビルドガイドで確認できます。</p></noscript>
      <div class="sim-layout">
        <form id="configurator" novalidate>
          <section class="panel">
            <div class="section-heading"><span class="step">01</span><div><h2>どこから組み立てる？</h2><p>まずは出発点を選択。あとから自由に変更できます。</p></div></div>
            <div class="presets" aria-label="構成の出発点">
              <button type="button" data-preset="kit">自分でつくる<span>ケースも自分で用意</span></button>
              <button type="button" data-preset="semi-case" aria-pressed="true">はんだ付けを少なく<span>半組 ＋ ケース付き</span></button>
              <button type="button" data-preset="assembled">本体の組立をおまかせ<span>モジュール等は別途</span></button>
            </div>
            <label class="field-label" for="assembly">本体の構成</label>
            <select id="assembly" name="assembly">{assemblies.map((a) => <option value={a.id} selected={a.id === 'semi-case'}>{a.name}　{a.price ? `＋${yen(a.price)}` : '追加料金なし'}</option>)}</select>
            <div class="base-price"><label for="price-base">本体の参照価格 <small>PCB・電子部品キット</small></label><div class="money-field"><span>¥</span><input id="price-base" name="base" type="number" min="0" max="10000000" step="1" value={catalog.basePrice} inputmode="numeric" /></div></div>
            <p class="small">参照日 {catalog.referenceDate}・<a href={catalog.productUrl} target="_blank" rel="noopener noreferrer">本体の価格を確認 ↗</a>。取得時に非公開表示もあったため、注文可能かも確認してください。必要なら金額を修正できます。</p>
            <p class="included">ソケット46個は付属。ケース付き構成には標準のゴールド（PETG）アクセントプレートが付属します。</p>
          </section>
          <section class="panel">
            <div class="section-heading"><span class="step">02</span><div><h2>操作を、自分に合わせる。</h2><p>対応するモジュールから選べます。費用は次のステップで入力。</p></div></div>
            <fieldset><legend>左手のモジュール</legend><div class="module-options">{modules.map((m) => <label class="module-option"><input type="radio" name="leftModule" value={m.id} checked={m.id === 'enc'} /><span class="module-symbol" aria-hidden="true">{m.id === 'enc' ? '◉' : m.id === 'tb' ? '●' : '✣'}</span><strong>{m.name}</strong><small>{m.detail}</small></label>)}</div></fieldset>
            <div class="fixed-module"><span class="side-tag">右手</span><strong>トラックボール</strong><span>この製品では右手は固定です</span></div>
          </section>
          <section class="panel">
            <div class="section-heading"><span class="step">03</span><div><h2>買い足すものを確認。</h2><p>単価ではなく、必要数分の合計額を入力してください。</p></div></div>
            <p class="input-note">未入力は「要確認」のまま残します。手持ちで必要数を満たすものはチェック。部品代に含まれるもの・送料無料は、確認したうえで0円を入力できます。</p>
            <div class="extra-list">{extras.map((e) => <div class="extra" data-extra={e.id} hidden={e.id === 'case'}><div class="extra-title"><label for={`price-${e.id}`}>{e.title} <span data-quantity={e.id}>{e.quantity}</span></label><p>{e.hint} {e.link && <a href={e.link} target="_blank" rel="noopener noreferrer">{e.linkText} ↗</a>}</p></div><div class="extra-controls"><label class="owned"><input type="checkbox" name={`owned-${e.id}`} />手持ちを使う</label><div class="money-field"><span>¥</span><input id={`price-${e.id}`} name={e.id} type="number" min="0" max="10000000" step="1" placeholder="未入力" inputmode="numeric" /></div></div></div>)}</div>
            <div class="extra"><div class="extra-title"><label for="price-shipping">送料 <span>全購入先の合計</span></label><p>自店・モジュール購入先など、複数店舗の送料を含めてください。</p></div><div class="money-field"><span>¥</span><input id="price-shipping" name="shipping" type="number" min="0" max="10000000" step="1" placeholder="未入力" inputmode="numeric" /></div></div>
            <details class="additional"><summary>工具・別色プレートなどの追加費用を入れる</summary><label class="field-label" for="price-other">その他の追加費用（合計・任意）</label><div class="money-field"><span>¥</span><input id="price-other" name="other" type="number" min="0" max="10000000" step="1" placeholder="未入力なら含めません" inputmode="numeric" /></div></details>
            <p class="small">手持ちの購入費は今回の追加費用に含めません。工具・印刷設備・任意の追加品は、入力しない限り計算に含みません。金額は0〜10,000,000円の整数で入力してください。</p>
          </section>
        </form>
        <aside class="estimate-column" aria-label="構成と費用の試算">
          <div class="estimate-panel">
            <p class="eyebrow">YOUR BUILD</p><h2>いまの構成</h2>
            <p id="build-description"></p>
            <div class="amount-summary" aria-live="polite" aria-atomic="true"><p id="total-label">入力済み小計</p><p class="total" id="total">—</p><p id="total-note"></p></div>
            <div class="mini-breakdown"><div><span>本体 ＋ 組立オプション</span><strong id="body-total">—</strong></div><div><span>別売部品・送料などの入力分</span><strong id="extra-total">—</strong></div></div>
            <div class="missing-box" id="missing-box"><strong id="missing-title"></strong><ul id="missing-list"></ul></div>
            <p class="estimate-disclaimer">参照価格＋入力額による試算です。販売価格・送料・在庫を保証するものではありません。</p>
            <a class="primary-button" href="#shopping">購入リストを見る <span aria-hidden="true">↓</span></a>
          </div>
          <div class="work-panel"><p class="eyebrow">AFTER PURCHASE</p><h2>購入後に行うこと</h2><ul id="work-list"></ul><p class="small">本体組立済みでも、別売品の準備・初期設定まで不要になるわけではありません。作業済みの範囲は注文時に確認してください。</p></div>
        </aside>
      </div>
      <section class="panel shopping-panel" id="shopping">
        <div class="shopping-heading"><div><p class="eyebrow">READY TO CHECK</p><h2>買うものを、ひとまとめに。</h2><p>購入先で価格と同梱品を照合してから注文してください。</p></div><button type="button" class="copy-button" id="copy-list">構成メモをコピー</button></div>
        <p id="copy-status" role="status"></p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="購入リスト（横にスクロールできます）"><table><thead><tr><th scope="col">商品・費用</th><th scope="col">必要数量</th><th scope="col">今回の費用</th><th scope="col">購入先・状態</th></tr></thead><tbody id="shopping-rows"></tbody></table></div>
        <p class="order-note" id="order-note"></p>
        <details id="copy-fallback" hidden><summary>構成メモを選択してコピー</summary><textarea id="memo" readonly aria-label="構成メモ"></textarea></details>
      </section>
      <footer class="page-footer"><p>このページは試作公開です。選択内容はサーバーへ送信・保存されません。<br />価格の参照元：<a href={catalog.productUrl}>本体商品ページ</a> / <a href={catalog.supportUrl}>サポート用商品</a> / <a href={`${base}guides/20geaconpolaris/`}>購入ガイド</a></p><a href={base}>Playgroundに戻る ↗</a></footer>
    </main>
  </body>
</html>

<script>
  import { estimate, buildShoppingText, yen } from '../lib/price-simulator.mjs';
  const form = document.querySelector<HTMLFormElement>('#configurator')!;
  const element = (id: string) => document.getElementById(id)!;
  const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  let result: ReturnType<typeof estimate>;
  const setText = (id: string, value: string) => { element(id).textContent = value; };
  function render() {
    const data = new FormData(form);
    const amounts = Object.fromEntries(['base', 'case', 'left', 'right', 'switches', 'keycaps', 'batteries', 'balls', 'shipping', 'other'].map((key) => [key, input(key).value]));
    const owned = Object.fromEntries(['case', 'left', 'right', 'switches', 'keycaps', 'batteries', 'balls'].map((key) => [key, data.has(`owned-${key}`)]));
    result = estimate({ assembly: data.get('assembly'), leftModule: data.get('leftModule'), amounts, owned });
    document.querySelector<HTMLElement>('[data-extra="case"]')!.hidden = result.assembly.hasCase;
    document.querySelector('[data-quantity="balls"]')!.textContent = `${result.balls}セット分`;
    document.querySelector('[data-quantity="left"]')!.textContent = `${result.left.name}・1個`;
    element('module-visual').className = result.left.id === 'tb' ? 'ball' : 'knob';
    for (const [key, value] of Object.entries(owned)) input(key).disabled = value;
    for (const key of Object.keys(amounts)) {
      const row = result.rows.find((r) => r.id === key);
      const invalid = !!row && !row.owned && String(amounts[key] ?? '').trim() !== '' && row.amount === null;
      input(key).setAttribute('aria-invalid', String(invalid));
    }
    setText('build-description', `${result.assembly.name}\n左：${result.left.name} / 右：トラックボール`);
    setText('total-label', result.complete ? '入力額による費用の目安' : '入力済み小計');
    setText('total', yen(result.total));
    setText('total-note', result.complete ? '送料を含む / 注文前に販売価格を再確認' : `あと${result.missing.length}項目の金額が必要です。総額はまだ確定していません。`);
    setText('body-total', result.rows[0].amount === null ? '本体価格を確認' : yen(result.rows.filter((r) => ['base','support'].includes(r.id)).reduce((s,r) => s + (r.amount ?? 0), 0)));
    setText('extra-total', yen(result.rows.filter((r) => !['base','support'].includes(r.id)).reduce((s,r) => s + (r.amount ?? 0), 0)));
    element('missing-box').hidden = result.complete;
    setText('missing-title', '未入力・金額を確認するもの');
    const list = (id: string, values: string[]) => element(id).replaceChildren(...values.map((v) => { const li = document.createElement('li'); li.textContent = v; return li; }));
    list('missing-list', result.missing.map((r) => r.label));
    list('work-list', result.work);
    element('shopping-rows').replaceChildren(...result.rows.map((row) => {
      const tr = document.createElement('tr');
      [row.label, row.quantity, row.owned ? '手持ち / 追加費用なし' : row.amount === null ? '金額を確認' : yen(row.amount)].forEach((v, index) => { const td = document.createElement(index === 0 ? 'th' : 'td'); if (index === 0) td.setAttribute('scope','row'); td.textContent = v; if (row.amount === null && index === 2) td.className = 'unpriced'; tr.append(td); });
      const td = document.createElement('td');
      if (row.url && !row.owned) { const a = document.createElement('a'); a.href = row.url; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = `${row.shop} ↗`; td.append(a); } else td.textContent = row.owned ? '必要数・対応を確認' : row.shop;
      tr.append(td); return tr;
    }));
    setText('order-note', result.assembly.supportUnits ? `本体と一緒に、サポート用商品の「100円」を${result.assembly.supportUnits}個購入する構成です。「10,000円」の商品とは別です。購入後、希望する「${result.assembly.name}」を販売者に連絡してください。` : '本体はPCB・電子部品のみの構成です。ケース・モジュール・別売部品は購入リストに沿って別途用意してください。');
    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.preset === result.assembly.id)));
    (element('memo') as HTMLTextAreaElement).value = buildShoppingText(result);
    setText('copy-status', '');
  }
  form.addEventListener('submit', (event) => event.preventDefault());
  form.addEventListener('input', (event) => {
    if ((event.target as HTMLInputElement).type === 'number') render();
  });
  form.addEventListener('change', (event) => {
    if ((event.target as HTMLInputElement).name === 'leftModule') {
      // A new module is a new quote. Never carry an unrelated price/ownership over.
      input('left').value = ''; input('owned-left').checked = false;
      input('balls').value = ''; input('owned-balls').checked = false;
    }
    render();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.addEventListener('click', () => { input('assembly').value = button.dataset.preset!; render(); }));
  element('copy-list').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(buildShoppingText(result)); setText('copy-status', '構成メモをコピーしました。'); }
    catch { const fallback = element('copy-fallback') as HTMLDetailsElement; fallback.hidden = false; fallback.open = true; const memo = element('memo') as HTMLTextAreaElement; memo.focus(); memo.select(); setText('copy-status', '自動コピーが使えません。下の構成メモを選択してコピーしてください。'); }
  });
  render();
</script>

<style>
  #shopping-rows :global(th), #shopping-rows :global(td){padding:15px 12px;border-bottom:1px solid var(--line);line-height:1.8}
  #shopping-rows :global(th){font-weight:500}
  #shopping-rows :global(td:nth-child(2)), #shopping-rows :global(td:nth-child(3)){white-space:nowrap}
  #work-list :global(li){margin-bottom:9px;padding-left:3px}
  #missing-list :global(li)::before{content:'・'}
  :root{--paper:#f4f4ee;--ink:#202a29;--muted:#65716b;--line:#dce0d7;--green:#32624c;--lime:#d5f580;--dark:#182b28;--orange:#a94d1e;font-family:'Yu Gothic','Hiragino Kaku Gothic ProN',sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none;color-scheme:light}
  *{box-sizing:border-box}body{margin:0}a{color:var(--green);text-underline-offset:4px}button,input,select,textarea{font:inherit}button,a,input,select,summary{touch-action:manipulation}:focus-visible{outline:3px solid #a26420;outline-offset:4px}button{cursor:pointer}input[type=checkbox],input[type=radio]{accent-color:var(--green)}[hidden]{display:none!important}.skip{position:absolute;top:-100px;left:20px;z-index:20}.skip:focus{top:10px;background:white;padding:12px}.topbar{max-width:1240px;margin:auto;padding:24px 32px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:16px}.brand{text-decoration:none;color:var(--ink);font-size:14px;font-weight:800;display:flex;align-items:center;gap:12px}.brand span{font-size:30px;color:var(--green)}.test-badge{font:11px monospace;letter-spacing:.06em;padding:6px 10px;border:1px solid #d1ab77;border-radius:5px;color:#7d4c0c;white-space:nowrap}main{max-width:1240px;margin:auto;padding:0 32px}.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:center;padding:52px 0 34px}.eyebrow{font:11px 'Cascadia Code',Consolas,monospace;font-weight:bold;letter-spacing:.16em;color:var(--green);margin:0 0 16px}h1{font-size:clamp(32px,3.9vw,48px);letter-spacing:-.045em;line-height:1.4;margin:0 0 20px}h2{font-size:21px;letter-spacing:-.02em;line-height:1.5;margin:0}p{line-height:1.8}.hero-copy{font-size:14px;color:var(--muted);margin:0 0 20px}.text-link{font-size:13px;font-weight:bold}.product-visual{height:245px;position:relative;display:flex;align-items:center;justify-content:center;flex-direction:column;background:radial-gradient(ellipse,#e0e7d6,transparent 70%);overflow:hidden}.orbit{position:absolute;width:360px;height:210px;border:1px solid #cbd5c3;border-radius:50%;transform:rotate(-14deg)}.keyboard{display:flex;gap:20px;position:relative;transform:rotate(-6deg);padding:20px}.half{position:relative;width:155px;height:128px;background:#304d45;border:3px solid #263e37;border-