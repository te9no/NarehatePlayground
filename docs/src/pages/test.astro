---
import { assemblies, products, catalog, estimate, yen } from '../lib/price-simulator.mjs';
import { moduleCatalog } from '../lib/simulator-catalog.mjs';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import SocialMeta from '../components/SocialMeta.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const initial = estimate();
const extraIds = ['caseData', 'case', 'left', 'right', 'iqsLeft', 'iqsRight', 'switches', 'keycaps', 'sockets', 'batteries', 'balls', 'moduleKeys'];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="GeaconPolaris・SparAkashaAnanta・MeKaBuの構成・追加費用・購入リストを確認する価格シミュレータ。" />
    <title>価格シミュレータ / TEST — なれはてぷれいぐらうんど</title>
    <link rel="icon" href={`${base}favicon.png`} />
    <SocialMeta title="価格シミュレータ / TEST — なれはてぷれいぐらうんど" description="GeaconPolaris・SparAkashaAnanta・MeKaBuの構成、追加費用、購入リストを確認する価格シミュレータ。" />
    <GoogleAnalytics />
  </head>
  <body>
    <a class="skip" href="#configurator">構成の選択へ</a>
    <header class="topbar">
      <a class="brand" href={base}><span aria-hidden="true">✳</span> なれはてぷれいぐらうんど</a>
      <span class="test-badge">TEST / 試作公開</span>
    </header>
    <main>
      <section class="hero" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">BUILD YOUR KEYBOARD</p>
          <h1 id="page-title">好きな構成を。<br />費用は、見える形に。</h1>
          <p class="hero-copy">製品と組み方、モジュールを選ぶと、必要な部品・費用・残る作業が<br class="desktop-break" />ひとつに。あなたの一台を組み立ててみましょう。</p>
          <a class="text-link" data-guide-link href={`${base}guides/20geaconpolaris/`}>選択した製品の購入・ビルドガイド <span aria-hidden="true">↗</span></a>
        </div>
        <div class="product-visual" aria-hidden="true">
          <div class="orbit"></div>
          <div class="keyboard"><div class="half left-half"><div class="keys">{Array.from({ length: 18 }).map(() => <i></i>)}</div><div class="knob" id="module-visual"></div><div class="thumbs"><i></i><i></i><i></i></div></div><div class="half right-half"><div class="keys">{Array.from({ length: 18 }).map(() => <i></i>)}</div><div class="ball" id="right-module-visual"></div><div class="thumbs"><i></i><i></i><i></i></div></div></div>
          <p><b id="visual-product">GeaconPolaris</b><span>構成イメージ / 実際の形状とは異なります</span></p>
        </div>
      </section>
      <p class="trial-note"><span>試作版</span> 3製品に対応。注文・決済は行いません。価格・在庫は自動更新されません。</p>
      <div class="test-entries">
        <div class="beginner-entry"><div><strong>はじめての方はこちら</strong><p>配列の違い、製品比較、変えられることを確認。必要部品を含む推奨構成から試算できます。</p></div><a href={`${base}test/choose/`}>自分に合う1台を選ぶ →</a></div>
        <div class="beginner-entry firmware-entry"><div><strong>Cornixトラパのファームウェア</strong><p>中央機器を選び、3台へ書き込むUF2と、接続を最初からやり直す手順を確認できます。</p></div><a href={`${base}test/cornix-firmware/`}>書き込みガイドを開く →</a></div>
      </div>
      <p class="reference-note" id="reference-note" hidden></p>
      <noscript><p class="error">このシミュレータの計算にはJavaScriptが必要です。購入条件はビルドガイドで確認できます。</p></noscript>
      <section class="lineup" aria-labelledby="lineup-title">
        <p class="eyebrow">CHOOSE YOUR KEYBOARD</p><h2 id="lineup-title">まずは、気になる一台から。</h2>
        <div class="product-options">{products.map((p) => <button type="button" data-product={p.id} aria-pressed={p.id === 'polaris'}><strong>{p.name}</strong><span>{p.description}</span><small>本体参照 {yen(p.basePrice)}〜</small></button>)}</div>
        <p class="small" id="product-change-note" role="status">製品を切り替えると、構成・入力価格・手持ちの選択は初期値に戻ります。</p>
      </section>
      <div class="sim-layout">
        <form id="configurator" novalidate>
          <section class="panel">
            <div class="section-heading"><span class="step">01</span><div><h2>どこから組み立てる？</h2><p>まずは出発点を選択。あとから自由に変更できます。</p></div></div>
            <div class="presets" aria-label="構成の出発点">
              <button type="button" data-preset="kit">自分でつくる<span>ケースも自分で用意</span></button>
              <button type="button" data-preset="case">3Dプリンタがない<span>ケース付きキット</span></button>
              <button type="button" data-preset="semi-case" aria-pressed="true">はんだ付けを少なく<span>半組 ＋ ケース付き</span></button>
              <button type="button" data-preset="assembled">本体の組立をおまかせ<span>モジュール等は別途</span></button>
            </div>
            <p class="input-note" id="printer-note">3Dプリンタがなくても、ケース付き構成なら本体の印刷は不要です。下で案内するBOOTHのモジュールにもハウジングが付属します。</p>
            <label class="field-label" for="assembly">本体の構成</label>
            <select id="assembly" name="assembly">{assemblies.map((a) => <option value={a.id} selected={a.id === 'semi-case'}>{a.name}　{a.price ? `＋${yen(a.price)}` : '追加料金なし'}</option>)}</select>
            <div class="base-price"><label for="price-base">本体の参照価格 <small id="base-kind">PCB・電子部品キット</small></label><div class="money-field"><span>¥</span><input id="price-base" name="base" type="number" min="0" max="10000000" step="1" value={catalog.basePrice} inputmode="numeric" /></div></div>
            <p class="small">参照日 {catalog.referenceDate}・<a data-product-link href={catalog.productUrl} target="_blank" rel="noopener noreferrer">本体の価格を確認 ↗</a>。価格・販売状況は注文時に確認してください。必要なら金額を修正できます。</p>
            <p class="included" id="included-note">{catalog.includedNote}</p>
            <div class="switch-choice"><label class="field-label" for="switch-type">本体のスイッチ方式</label><select id="switch-type" name="switchType"><option value="choc">Choc V2互換</option></select></div>
          </section>
          <section class="panel">
            <div class="section-heading"><span class="step">02</span><div><h2>操作を、自分に合わせる。</h2><p>BOOTHで確認したモジュール価格を自動入力。次のステップで修正できます。</p></div></div>
            {['left', 'right'].map((side) => <fieldset class={side === 'right' ? 'right-modules' : ''}><legend>{side === 'left' ? '左' : '右'}手のモジュール</legend><div class="module-options">{Object.values(moduleCatalog).map((m) => <label class="module-option" data-module-side={side} data-module-id={m.id} hidden={!catalog[`${side}Modules`].includes(m.id)}><input type="radio" name={`${side}Module`} value={m.id} checked={m.id === (side === 'left' ? 'enc' : 'tb')} /><span class="module-symbol" aria-hidden="true">{m.id === 'tb' ? '●' : m.id === 'enc' ? '◉' : m.id === 'joy' ? '✣' : '▣'}</span><strong>{m.name}</strong><small>{m.detail}</small><span class="module-price">{yen(m.price)}</span></label>)}</div></fieldset>)}
            <p class="input-note" id="bundle-note" hidden>MeKaBuのこのキットにはエンコーダ1個・トラボ1個が付属します。左右を入れ替えて使えます。同じ種類を2個選ぶ場合は、足りない1個だけ別途購入します。</p>
            <p class="input-note" id="right-module-note">{initial.right.note}</p>
            <div class="ananta-iqs" id="ananta-iqs" hidden>
              <h3>追加IQS（Ananta専用・任意）</h3>
              <p class="small">通常モジュールとは別の外付けです。「SparAkashaAnanta用（左右ハウジングセット）」はモジュール1個につき9,500円。両側に載せる場合は2個分で計算します。IQSを載せる側はOLEDを取り付けません。</p>
              <div class="iqs-choices"><label><input type="checkbox" name="enable-iqsLeft" />左にIQSを追加</label><label><input type="checkbox" name="enable-iqsRight" />右にIQSを追加</label></div>
              <label class="field-label" for="central-side">ファームウェアで設定するCentral側</label><select id="central-side" name="centralSide"><option value="">未選択（IQS追加時に必要）</option><option value="left">左がCentral / 右がPeripheral</option><option value="right">右がCentral / 左がPeripheral</option></select>
              <p class="small">Peripheral側のトラボ・トラパ・スティック＋IQSはサポート対象外です。接続先を変えるだけではなく、実際のファームウェア設定と合わせてください。</p>
            </div>
            <p class="small">BOOTH参照日：{catalog.referenceDate}（自動更新ではありません）。販売元：<a href={catalog.moduleUrl} target="_blank" rel="noopener noreferrer">なれはてぷれいぐらうんど</a>。別途購入するトラボ・エンコーダ・スティック＋エンコーダの組立済みオプションは1個につき＋500円（サポート用Aを5個）。希望する個数分を「その他の追加費用」に入力し、注文後すぐに適用するモジュールを販売者へ連絡してください。トラパ・IQSの組立状態は各商品ページを確認してください。</p>
          </section>
          <section class="panel">
            <div class="section-heading"><span class="step">03</span><div><h2>買い足すものを確認。</h2><p>単価ではなく、必要数分の合計額を入力してください。</p></div></div>
            <p class="input-note">未入力は「要確認」のまま残します。手持ちで必要数を満たすものはチェック。部品代に含まれるもの・送料無料は、確認したうえで0円を入力できます。</p>
            <div class="extra-list">{extraIds.map((id) => { const row = initial.rows.find((r) => r.id === id); return <div class="extra" data-extra={id} hidden={!row}><div class="extra-title"><label for={`price-${id}`}><b id={`title-${id}`}>{row?.label ?? id}</b><span id={`quantity-${id}`}>{row?.quantity}</span></label><p><span id={`hint-${id}`}></span> <a id={`source-${id}`} href={row?.url} hidden={!row?.url} target="_blank" rel="noopener noreferrer">商品・仕様を確認 ↗</a></p><p class="included-status" id={`included-${id}`} hidden>キットに同梱 / 追加0円</p></div><div class="extra-controls"><label class="owned"><input type="checkbox" name={`owned-${id}`} />手持ちを使う</label><div class="money-field"><span>¥</span><input id={`price-${id}`} name={id} type="number" min="0" max="10000000" step="1" value={row?.amount ?? undefined} placeholder="未入力" inputmode="numeric" /></div></div></div>; })}</div>
            <div class="extra"><div class="extra-title"><label for="price-shipping">送料 <span>全購入先の合計</span></label><p>自店・モジュール購入先など、複数店舗の送料を含めてください。</p></div><div class="money-field"><span>¥</span><input id="price-shipping" name="shipping" type="number" min="0" max="10000000" step="1" placeholder="未入力" inputmode="numeric" /></div></div>
            <details class="additional"><summary>工具・別色プレートなどの追加費用を入れる</summary><label class="field-label" for="price-other">その他の追加費用（合計・任意）</label><div class="money-field"><span>¥</span><input id="price-other" name="other" type="number" min="0" max="10000000" step="1" placeholder="未入力なら含めません" inputmode="numeric" /></div></details>
            <p class="small">手持ちの購入費は今回の追加費用に含めません。工具・印刷設備・任意の追加品は、入力しない限り計算に含みません。金額は0〜10,000,000円の整数で入力してください。</p>
          </section>
        </form>
        <aside class="estimate-column" aria-label="構成と費用の試算">
          <div class="estimate-panel">
            <p class="eyebrow">YOUR BUILD</p><h2>いまの構成</h2>
            <p id="build-description"></p>
            <div class="amount-summary" aria-live="polite" aria-atomic="true"><p id="total-label">入力済み小計</p><p class="total" id="total">—</p><p id="total-note"></p></div>
            <div class="mini-breakdown"><div><span>本体 ＋ 組立オプション</span><strong id="body-total">—</strong></div><div><span>別売部品・送料などの入力分</span><strong id="extra-total">—</strong></div></div>
            <div class="missing-box" id="missing-box"><strong id="missing-title"></strong><ul id="missing-list"></ul></div>
            <div class="config-warning" id="config-warning" hidden role="status"><strong>構成の変更・確認が必要です</strong><ul id="warning-list"></ul></div>
            <p class="estimate-disclaimer">参照価格＋入力額による試算です。販売価格・送料・在庫を保証するものではありません。</p>
            <a class="primary-button" href="#shopping">購入リストを見る <span aria-hidden="true">↓</span></a>
          </div>
          <div class="work-panel"><p class="eyebrow">AFTER PURCHASE</p><h2>購入後に行うこと</h2><ul id="work-list"></ul><p class="small">本体組立済みでも、別売品の準備・初期設定まで不要になるわけではありません。作業済みの範囲は注文時に確認してください。</p></div>
        </aside>
      </div>
      <section class="panel shopping-panel" id="shopping">
        <div class="shopping-heading"><div><p class="eyebrow">READY TO CHECK</p><h2>買うものを、ひとまとめに。</h2><p>購入先で価格と同梱品を照合してから注文してください。</p></div><button type="button" class="copy-button" id="copy-list">構成メモをコピー</button></div>
        <p id="copy-status" role="status"></p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="購入リスト（横にスクロールできます）"><table><thead><tr><th scope="col">商品・費用</th><th scope="col">必要数量</th><th scope="col">今回の費用</th><th scope="col">購入先・状態</th></tr></thead><tbody id="shopping-rows"></tbody></table></div>
        <p class="order-note" id="order-note"></p>
        <details id="copy-fallback" hidden><summary>構成メモを選択してコピー</summary><textarea id="memo" readonly aria-label="構成メモ"></textarea></details>
      </section>
      <footer class="page-footer"><p>このページは試作公開です。選択内容はサーバーへ送信・保存されません。<br />価格の参照元：<a data-product-link href={catalog.productUrl}>本体商品ページ</a><span id="support-reference"> / <a id="support-link" href={catalog.supportUrl}>サポート用商品</a></span> / <a data-guide-link href={`${base}guides/20geaconpolaris/`}>購入ガイド</a></p><a href={base}>Playgroundに戻る ↗</a></footer>
    </main>
  </body>
</html>

<script>import "../lib/simulator-client";</script>

<style>
  .test-entries{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px 0 28px}.beginner-entry{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 24px;background:#edf3e3;border:1px solid #c9d8b8;border-radius:10px;margin:0}.beginner-entry strong{font-size:18px}.beginner-entry p{font-size:12px;line-height:1.9;margin:8px 0 0}.beginner-entry a{font-size:13px;font-weight:bold;color:#315c4b}.firmware-entry{background:#fff1df;border-color:#d8ba8e}.reference-note{font-size:12px;line-height:1.9;border-left:4px solid #ac783a;padding:18px;background:#fff5e5}.reference-note[hidden]{display:none}@media(max-width:900px){.test-entries{grid-template-columns:1fr}}@media(max-width:620px){.beginner-entry{display:block;padding:20px}.beginner-entry a{display:inline-block;margin-top:15px}}
  .lineup{margin:20px 0 30px}.lineup .eyebrow{margin-bottom:8px}.product-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px}.product-options button{border:1px solid var(--line);background:#fff;border-radius:10px;padding:20px;text-align:left;color:var(--ink)}.product-options button[aria-pressed=true]{border:2px solid var(--green);background:#eff5e7;padding:19px}.product-options strong{display:block;font-size:18px;overflow-wrap:anywhere}.product-options span,.product-options small{display:block;font-size:11px;line-height:1.8;margin-top:10px}.product-options span{color:var(--muted)}.product-options small{color:var(--green)}.switch-choice{margin-top:20px}.ananta-iqs{padding:18px;background:#f3f6ee;border-radius:8px;margin-top:20px}.ananta-iqs h3{font-size:15px;margin:0}.iqs-choices{display:flex;gap:15px;flex-wrap:wrap;font-size:12px;margin:18px 0}.config-warning{border:1px solid #eead73;background:#422c21;color:#ffdfbf;font-size:12px;padding:15px;border-radius:8px;margin-top:15px}.config-warning ul{padding-left:18px;line-height:1.9}.included-status{font-weight:bold;color:var(--green)!important}.extra-title label>b{font-weight:inherit}.module-price{margin-top:auto!important;padding-top:12px}
  @media(max-width:620px){.product-options{grid-template-columns:1fr;gap:8px}.product-options button{padding:15px}.product-options button[aria-pressed=true]{padding:14px}.product-options strong{font-size:17px}.product-options span,.product-options small{margin-top:5px}}
  .right-modules{margin-top:24px}#right-module-note{margin-top:16px}
  .pad{position:absolute;bottom:10px;right:10px;width:40px;height:27px;border:3px solid #233d32;border-radius:5px;background:#c9dcb3;box-shadow:0 0 0 2px #a5baa0}
  .module-price{margin-top:12px;font-size:15px;font-weight:bold;color:var(--green);font-variant-numeric:tabular-nums}
  #printer-note{margin-bottom:20px}
  #shopping-rows :global(th), #shopping-rows :global(td){padding:15px 12px;border-bottom:1px solid var(--line);line-height:1.8}
  #shopping-rows :global(th){font-weight:500}
  #shopping-rows :global(td:nth-child(2)), #shopping-rows :global(td:nth-child(3)){white-space:nowrap}
  #work-list :global(li){margin-bottom:9px;padding-left:3px}
  #missing-list :global(li)::before{content:'・'}
  :root{--paper:#f4f4ee;--ink:#202a29;--muted:#65716b;--line:#dce0d7;--green:#32624c;--lime:#d5f580;--dark:#182b28;--orange:#a94d1e;font-family:'Yu Gothic','Hiragino Kaku Gothic ProN',sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none;color-scheme:light}
  *{box-sizing:border-box}body{margin:0}a{color:var(--green);text-underline-offset:4px}button,input,select,textarea{font:inherit}button,a,input,select,summary{touch-action:manipulation}:focus-visible{outline:3px solid #a26420;outline-offset:4px}button{cursor:pointer}input[type=checkbox],input[type=radio]{accent-color:var(--green)}[hidden]{display:none!important}.skip{position:absolute;top:-100px;left:20px;z-index:20}.skip:focus{top:10px;background:white;padding:12px}.topbar{max-width:1240px;margin:auto;padding:24px 32px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:16px}.brand{text-decoration:none;color:var(--ink);font-size:14px;font-weight:800;display:flex;align-items:center;gap:12px}.brand span{font-size:30px;color:var(--green)}.test-badge{font:11px monospace;letter-spacing:.06em;padding:6px 10px;border:1px solid #d1ab77;border-radius:5px;color:#7d4c0c;white-space:nowrap}main{max-width:1240px;margin:auto;padding:0 32px}.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:center;padding:52px 0 34px}.eyebrow{font:11px 'Cascadia Code',Consolas,monospace;font-weight:bold;letter-spacing:.16em;color:var(--green);margin:0 0 16px}h1{font-size:clamp(32px,3.9vw,48px);letter-spacing:-.045em;line-height:1.4;margin:0 0 20px}h2{font-size:21px;letter-spacing:-.02em;line-height:1.5;margin:0}p{line-height:1.8}.hero-copy{font-size:14px;color:var(--muted);margin:0 0 20px}.text-link{font-size:13px;font-weight:bold}.product-visual{height:245px;position:relative;display:flex;align-items:center;justify-content:center;flex-direction:column;background:radial-gradient(ellipse,#e0e7d6,transparent 70%);overflow:hidden}.orbit{position:absolute;width:360px;height:210px;border:1px solid #cbd5c3;border-radius:50%;transform:rotate(-14deg)}.keyboard{display:flex;gap:20px;position:relative;transform:rotate(-6deg);padding:20px}.half{position:relative;width:155px;height:128px;background:#304d45;border:3px solid #263e37;border-