---
export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/docs/guides/*.{md,mdx}', { eager: true });
  return Promise.all(Object.entries(modules).map(async ([file, module]) => {
    const filename = file.split('/').pop() ?? '';
    const slug = filename.replace(/\.(md|mdx)$/, '').toLowerCase().replace(/[^a-z0-9]+/g, '');
    const headings = typeof module.getHeadings === 'function' ? await module.getHeadings() : [];
    return { params: { slug }, props: { module, filename, headings: headings.filter((heading) => heading.depth > 1 && heading.depth < 4) } };
  }));
}

const { module, filename, headings } = Astro.props;
const Content = module.Content;
const title = module.frontmatter?.title || filename.replace(/\.(md|mdx)$/, '');
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Narehate Playground</title>
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <style>
      :root { color-scheme: dark; --bg:#05070d; --ink:#f6f8ff; --muted:rgba(246,248,255,.68); --line:rgba(77,232,255,.24); --cyan:#4de8ff; --hot:#ff3d71; }
      * { box-sizing: border-box; }
      body { margin: 0; color: var(--ink); font-family: "Yu Gothic", "Hiragino Kaku Gothic ProN", sans-serif; background: radial-gradient(circle at 20% 0%, rgba(77,232,255,.18), transparent 28rem), var(--bg); }
      .guide-layout {
        width: min(1360px, calc(100% - 32px));
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(180px, 260px) minmax(0, 920px);
        gap: clamp(1rem, 4vw, 3.5rem);
        align-items: start;
        padding: 2rem 0 5rem;
      }
      main { min-width: 0; }
      a { color: var(--cyan); }
      .back { display: inline-flex; margin-bottom: 2rem; border:1px solid var(--line); border-radius:999px; padding:.6rem .9rem; text-decoration:none; color:var(--ink); }
      .toc {
        position: sticky;
        top: 1rem;
        max-height: calc(100vh - 2rem);
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 1rem;
        background: rgba(3, 8, 18, .72);
        backdrop-filter: blur(18px);
        box-shadow: 0 24px 80px rgba(0,0,0,.28);
      }
      .toc-title {
        margin: 0;
        color: var(--cyan);
        font-family: "Cascadia Code", Consolas, monospace;
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
      }
      .toc-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .9rem;
      }
      .toc-toggle {
        display: none;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .35rem .65rem;
        color: var(--ink);
        background: rgba(77, 232, 255, .1);
        font: inherit;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .toc nav {
        display: grid;
        gap: .35rem;
      }
      .toc a {
        display: block;
        border-left: 2px solid transparent;
        padding: .35rem .35rem .35rem .65rem;
        color: var(--muted);
        text-decoration: none;
        font-size: .88rem;
        line-height: 1.35;
        transition: color .16s ease, border-color .16s ease, background .16s ease;
      }
      .toc a:hover,
      .toc a.is-active {
        border-color: var(--cyan);
        color: var(--ink);
        background: rgba(77, 232, 255, .08);
      }
      .toc a[data-depth="3"] {
        margin-left: .75rem;
        font-size: .8rem;
      }
      h1 { font-size: clamp(1.8rem, 4vw, 3rem); line-height:1.35; letter-spacing:-.025em; overflow-wrap: anywhere; }
      :global(h2), :global(h3) { scroll-margin-top: 1.5rem; }
      :global(img) {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
        border-radius: 22px;
        border: 1px solid var(--line);
        box-shadow: 0 20px 70px rgba(0,0,0,.32);
        cursor: zoom-in;
        object-fit: contain;
      }
      :global(p), :global(li) { color: var(--muted); line-height: 1.85; }
      :global(code) { color: var(--cyan); }
      :global(table) { display: block; overflow-x: auto; border-collapse: collapse; }
      :global(th), :global(td) { border: 1px solid var(--line); padding: .5rem .75rem; }
      :global(th:first-child), :global(td:first-child) { min-width: 7em; }
      :global(td) { line-height: 1.7; vertical-align: top; }
      .image-dialog {
        width: min(100vw - 24px, 1280px);
        max-height: calc(100dvh - 24px);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 0;
        background: rgba(2, 6, 13, .96);
        box-shadow: 0 40px 140px rgba(0,0,0,.72);
      }
      .image-dialog::backdrop {
        background: rgba(0, 0, 0, .78);
        backdrop-filter: blur(10px);
      }
      .image-dialog img {
        width: 100%;
        max-height: calc(100dvh - 84px);
        border: 0;
        border-radius: 24px 24px 0 0;
        box-shadow: none;
        cursor: zoom-out;
        object-fit: contain;
      }
      .image-dialog button {
        width: 100%;
        border: 0;
        border-top: 1px solid var(--line);
        padding: .9rem 1rem;
        color: var(--ink);
        background: rgba(77, 232, 255, .1);
        font: inherit;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      @media (max-width: 640px) {
        .guide-layout { width: min(100% - 20px, 920px); }
        :global(img) { border-radius: 16px; }
        .image-dialog {
          width: calc(100vw - 12px);
          max-height: calc(100dvh - 12px);
          border-radius: 18px;
        }
        .image-dialog img {
          max-height: calc(100dvh - 70px);
          border-radius: 18px 18px 0 0;
        }
      }
      @media (max-width: 900px) {
        :global(h2), :global(h3) { scroll-margin-top: 6rem; }
        .guide-layout {
          grid-template-columns: 1fr;
          gap: 1.25rem;
        }
        .toc {
          position: sticky;
          top: 0;
          z-index: 5;
          max-height: 42vh;
          border-radius: 0 0 20px 20px;
          padding: .75rem;
        }
        .toc-head { margin-bottom: 0; }
        .toc-toggle { display: inline-flex; align-items: center; }
        .toc nav {
          max-height: 0;
          overflow: hidden;
          opacity: 0;
          transition: max-height .2s ease, opacity .2s ease, margin-top .2s ease;
        }
        .toc.is-open nav {
          max-height: 32vh;
          overflow: auto;
          opacity: 1;
          margin-top: .75rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="guide-layout">
      {headings.length > 0 && (
        <aside class="toc" aria-label="目次">
          <div class="toc-head">
            <p class="toc-title">目次</p>
            <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="guide-toc">開く</button>
          </div>
          <nav id="guide-toc">
            {headings.map((heading) => (
              <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
      <main>
        <a class="back" href="../../">Back to Playground</a>
        <h1>{title}</h1>
        <Content />
      </main>
    </div>
    <dialog class="image-dialog" aria-label="Expanded image">
      <img alt="" />
      <button type="button">Close</button>
    </dialog>
    <script is:inline>
      const dialog = document.querySelector('.image-dialog');
      const dialogImage = dialog?.querySelector('img');
      const closeButton = dialog?.querySelector('button');

      document.querySelectorAll('main img').forEach((image) => {
        image.addEventListener('click', () => {
          if (!dialog || !dialogImage) return;
          dialogImage.src = image.currentSrc || image.src;
          dialogImage.alt = image.alt || '';
          if (typeof dialog.showModal === 'function') {
            dialog.showModal();
          }
        });
      });

      closeButton?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog || event.target === dialogImage) dialog.close();
      });
      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && dialog?.open) dialog.close();
      });

      const tocLinks = Array.from(document.querySelectorAll('.toc a'));
      const toc = document.querySelector('.toc');
      const tocToggle = document.querySelector('.toc-toggle');
      const sections = tocLinks
        .map((link) => document.getElementById(link.getAttribute('href').slice(1)))
        .filter(Boolean);

      tocToggle?.addEventListener('click', () => {
        const isOpen = toc?.classList.toggle('is-open') ?? false;
        tocToggle.setAttribute('aria-expanded', String(isOpen));
        tocToggle.textContent = isOpen ? '閉じる' : '開く';
      });

      tocLinks.forEach((link) => {
        link.addEventListener('click', () => {
          if (!window.matchMedia('(max-width: 900px)').matches) return;
          toc?.classList.remove('is-open');
          tocToggle?.setAttribute('aria-expanded', 'false');
          if (tocToggle) tocToggle.textContent = '開く';
        });
      });

      if ('IntersectionObserver' in window && sections.length > 0) {
        const observer = new IntersectionObserver((entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          tocLinks.forEach((link) => {
            const isActive = link.getAttribute('href') === `#${visible.target.id}`;
            link.classList.toggle('is-active', isActive);
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }, { rootMargin: '0px 0px -60% 0px', threshold: [0, .4, 1] });

        sections.forEach((section) => observer.observe(section));
      }
    </script>
  </body>
</html>



