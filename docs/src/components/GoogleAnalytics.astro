---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const enabled = /^G-[A-Z0-9]+$/.test(measurementId ?? '');
---
{enabled && <>
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
  <script is:inline define:vars={{ measurementId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', measurementId);
  </script>
</>}
